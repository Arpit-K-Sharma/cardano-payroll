# === Kuber API Configuration ===
# The base URL for the Kuber Cardano API (use the correct network endpoint)
NEXT_PUBLIC_KUBER_API_URL=https://preprod.kuber.cardanoapi.io

# Your Kuber API key (keep this secret!)
NEXT_PUBLIC_KUBER_API_KEY=your_kuber_api_key_here

# === Backend API Configuration ===
# The base URL for your backend server
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# === Company Wallet ===
# The Cardano wallet address used by your company
NEXT_PUBLIC_COMPANY_WALLET_ADDRESS=addr1...

# === Cardano Network Selection ===
# Set to 'mainnet', 'preprod', or 'preview' to match your deployment
NEXT_PUBLIC_CARDANO_NETWORK=preprod